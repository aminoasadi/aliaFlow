DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# ArvanCloud S3-compatible object storage (media library uploads).
# Bucket endpoint: https://aliaflow.s3.ir-thr-at1.arvanstorage.ir
# When these are unset, uploads fall back to local disk storage (dev only).
ARVAN_S3_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
ARVAN_S3_REGION="ir-thr-at1"
ARVAN_S3_BUCKET="aliaflow"
ARVAN_S3_ACCESS_KEY="replace-with-access-key"
ARVAN_S3_SECRET_KEY="replace-with-secret-key"
# Optional override; defaults to https://<bucket>.<endpoint host>
ARVAN_S3_PUBLIC_URL_BASE="https://aliaflow.s3.ir-thr-at1.arvanstorage.ir"
